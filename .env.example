# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional connection string for a live PostgreSQL database (e.g., postgres://user:password@host:port/dbname).
# If left empty, the application falls back to local file storage (db.json).
DATABASE_URL=